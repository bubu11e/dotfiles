{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "model": "opus",
  "attribution": false,
  "skillOverrides": {
    "setup-pre-commit": "off",
    "migrate-to-shoehorn": "off",
    "scaffold-exercises": "off",
    "ponytail-gain": "user-invocable-only",
    "ponytail-help": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf \"{\\\"systemMessage\\\":\\\"ANTHROPIC_BASE_URL=%s\\\"}\" \"${ANTHROPIC_BASE_URL:-<unset>}\""
          }
        ]
      }
    ]
  }
}
