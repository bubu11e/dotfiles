# Managed by chezmoi. Edit the source: `chezmoi edit ~/.shell.env`.
#
# Cross-shell environment, POSIX sh only — no bashisms, no zsh syntax. Sourced by
# ~/.zshenv (every zsh, interactive or not) and by ~/.bashrc (before its
# interactivity guard, so `ssh host 'cmd'` gets a usable PATH too).
#
# Keep this file env-only and idempotent: it is re-sourced by every nested shell.
# Aliases go in ~/.shell.aliases, interactive setup in the per-shell rc.

# --- homebrew ---
# Homebrew lives at a non-standard ~/.homebrew prefix (no root required). The `sh`
# flavour of shellenv is used deliberately: it is POSIX, unlike the zsh flavour
# which emits `fpath[1,0]=...`. The zsh-only fpath line it leaves out is added back
# by ~/.zshenv, which is the only shell that needs it.
if [ -x "$HOME/.homebrew/bin/brew" ]; then
    eval "$("$HOME/.homebrew/bin/brew" shellenv sh)"
fi

# --- locale ---
# Only set where the answer is known. macOS leaves LANG unset and every tool then
# falls back to ASCII, and en_US.UTF-8 is always available there. Linux hosts get
# theirs from systemd/PAM, and naming a locale a minimal image has not generated
# makes bash print "setlocale: cannot change locale" on every single start — a
# stock debian:12 ships only C, C.utf8 and POSIX. A Linux box that genuinely needs
# an override has ~/.shell.env.local for it.
#
# LC_ALL is deliberately not set: it outranks every LC_* category, which makes it a
# tool for one-off overrides rather than something a dotfile should pin.
case "${OSTYPE:-}" in
    darwin*) [ -n "${LANG:-}" ] || export LANG=en_US.UTF-8 ;;
esac

# --- editor ---
export EDITOR=vim

# --- path helpers ---
# Move $1 to the front of $PATH, dropping any existing occurrence, so repeated
# calls reorder instead of duplicating. Reordering (not just "skip if present") is
# the point: macOS runs /usr/libexec/path_helper from /etc/zprofile and
# /etc/profile *after* this file, which rebuilds $PATH with the system dirs first
# and demotes these entries below /usr/bin. Each interactive rc calls
# _dotfiles_user_path again afterwards to restore precedence.
_dotfiles_path_prepend() {
    [ -d "$1" ] || return 0
    # zsh does not word-split unquoted parameters; the loop below needs it to.
    # LOCAL_OPTIONS scopes the change to this function. bash never reaches this
    # branch, and parses the line fine.
    if [ -n "${ZSH_VERSION:-}" ]; then
        setopt LOCAL_OPTIONS SH_WORD_SPLIT
    fi
    _dpp_new="$1"
    _dpp_out="$_dpp_new"
    _dpp_ifs="$IFS"
    IFS=:
    for _dpp_dir in $PATH; do
        [ "$_dpp_dir" = "$_dpp_new" ] || _dpp_out="$_dpp_out:$_dpp_dir"
    done
    IFS="$_dpp_ifs"
    PATH="$_dpp_out"
    export PATH
    unset _dpp_new _dpp_out _dpp_ifs _dpp_dir
}

# Append $1 only if absent, so it can never shadow an earlier entry.
_dotfiles_path_append() {
    [ -d "$1" ] || return 0
    case ":${PATH}:" in
        *":$1:"*) ;;
        *) PATH="${PATH}:$1" ; export PATH ;;
    esac
}

# The user-local PATH, as one callable unit. Listed lowest-precedence first: each
# prepend pushes the previous one down, so gnubin ends up ahead of ~/.local/bin.
_dotfiles_user_path() {
    _dotfiles_path_prepend "$HOME/.local/bin"
    _dotfiles_path_prepend "$HOME/.homebrew/opt/gnu-sed/libexec/gnubin"
    _dotfiles_path_append "$HOME/.lmstudio/bin"
}
_dotfiles_user_path

# --- golang ---
# Needs brew's $PATH from above to find `go`.
if command -v go >/dev/null 2>&1; then
    export GOPATH="$HOME/go"
    _dotfiles_path_append "$GOPATH/bin"
fi
{{ if .docker.socketPath }}
# --- docker ---
# Point the docker CLI (and DOCKER_HOST-aware clients) at a custom socket. Guarded
# on the prompted path, independently of whether the docker binary is installed.
export DOCKER_HOST='{{ .docker.socketPath }}'
{{ end }}
# --- local overrides ---
[ -f "$HOME/.shell.env.local" ] && . "$HOME/.shell.env.local"
